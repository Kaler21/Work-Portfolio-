import pandas as pd

# Read files
gdp = pd.read_csv("Word_GDP.csv", skiprows=4)

cpi = pd.read_csv(
    "california_cpi_minimum_wage_occupations_2010_2025.csv"
)

# Select USA
usa = gdp[gdp["Country Name"] == "United States"]

# Turn GDP year columns into rows
usa = usa.melt(
    id_vars=["Country Name"],
    value_vars=[str(year) for year in range(2010, 2026)],
    var_name="Year",
    value_name="GDP"
)

# Convert Year to integer
usa["Year"] = usa["Year"].astype(int)

# Select California CPI information
california = cpi[
    ["Year", "California CPI Index", "CPI Annual Change %"]
].drop_duplicates()

# Merge California CPI with USA GDP
merged = pd.merge(
    california,
    usa,
    on="Year",
    how="inner"
)
#data wrangling
data = merged.sort_values(
    by=["Year", "GDP"],
    ascending=False
)
