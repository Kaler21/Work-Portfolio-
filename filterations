import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

sns.set_theme(style="darkgrid")

WORD_GDP = pd.read_csv(
    "california_housing_cpi_subtable.csv"
)

# Remove commas and convert home prices to numbers
WORD_GDP["Median Home Price"] = (
    WORD_GDP["Median Home Price"]
    .astype(str)
    .str.replace(",", "", regex=False)
    .astype(float)
)

# Keep unique Year / Median Home Price combinations
formate_ = WORD_GDP[
    ["Year", "Median Home Price"]
].drop_duplicates()

# Only show 2020 and later
formate_ = formate_[
    formate_["Year"] >= 2020
]

# Create bar plot
plt.figure(figsize=(10, 6))

sns.barplot(
    data=formate_,
    x="Year",
    y="Median Home Price"
)

plt.xlabel("Year")
plt.ylabel("Median Home Price")
plt.title("California Median Home Price by Year")

plt.show()

